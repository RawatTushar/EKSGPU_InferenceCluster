name: "pytorch-resnet50"
platform: "pytorch_libtorch"

max_batch_size: 10

dynamic_batching {
    preferred_batch_size: [5]
    max_queue_delay_microseconds: 1000
}

input [
  {
    name: "input__0"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "output__0"
    data_type: TYPE_FP32
    dims: [ 1, 1000, 1, 1 ]
  }
]