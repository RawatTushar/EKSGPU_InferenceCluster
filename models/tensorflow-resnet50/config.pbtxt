name: "tensorflow-resnet50"
backend: "onnxruntime"

max_batch_size: 10
dynamic_batching {
    preferred_batch_size: [5]
    max_queue_delay_microseconds: 1000
}

input [
  {
    name: "inputs"
    data_type: TYPE_FP32
    dims: [ 224, 224, 3 ]
  }
]

output [
  {
    name: "output_0"
    data_type: TYPE_FP32
    dims: [ 1000 ]
  }
]